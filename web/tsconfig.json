{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": "./",
    "rootDirs": ["./src", "../.redwood/types/mirror/web/src", "../api/src"],
    "paths": {
      "src/*": ["./src/*", "../.redwood/types/mirror/web/src/*"],
      "$api/*": ["../api/*"]
    },
    "typeRoots": ["../node_modules/@types", "./node_modules/@types"],
    "types": ["jest", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "../.redwood/types/includes/*",
    "../.redwood/types/mirror/web/src"
  ]
}
